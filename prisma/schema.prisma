datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  HOLD
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}
enum BlockReason {
  CANCELLED
  DECLINED
  EXPIRED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  slotsCreated     AppointmentSlot[] @relation("StaffSlots")
  appointmentsMade Appointment[]
  waitlistEntries  WaitlistEntry[]
  slotBlocks       SlotBlock[]

  @@map("users")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  slots AppointmentSlot[]

  @@map("businesses")
}

model AppointmentSlot {
  id         String     @id @default(uuid()) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  staffId    String     @map("staff_id") @db.Uuid
  startTime  DateTime   @map("start_time")
  endTime    DateTime   @map("end_time")
  status     SlotStatus @default(AVAILABLE)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    User     @relation("StaffSlots", fields: [staffId], references: [id], onDelete: Cascade)
  appointment     Appointment?
  waitlistEntries WaitlistEntry[]
  slotBlocks      SlotBlock[]

  @@map("appointment_slots")
}

model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  slotId     String            @unique @map("slot_id") @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  status     AppointmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now()) @map("created_at")
  slot     AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model WaitlistEntry {
  id         String   @id @default(uuid()) @db.Uuid
  slotId     String   @map("slot_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  priority   Int
  createdAt  DateTime @default(now()) @map("created_at")
  slot     AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([slotId, customerId])
  @@map("waitlist_entries")
}
model SlotBlock {
  id         String      @id @default(uuid()) @db.Uuid
  slotId     String      @map("slot_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  reason     BlockReason
  createdAt  DateTime    @default(now()) @map("created_at")

  slot     AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([slotId, customerId])
  @@map("slot_blocks")
}
